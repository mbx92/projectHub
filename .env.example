DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/projecthub
NUXT_SESSION_SECRET=ganti-dengan-string-acak-64-karakter
NUXT_FILE_SECRET=ganti-dengan-string-acak-64-karakter
NUXT_APP_URL=http://localhost:3000
NUXT_STORAGE_DIR=./storage

# SMTP (kosongkan untuk mode dev: email dicetak ke log server)
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=587
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
NUXT_SMTP_FROM="OCN Project Hub <no-reply@example.com>"

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ganti-saya

# Seeder demo (npm run db:seed:demo): kata sandi akun demo Developer/Investor.
# Ganti, dan jalankan `npm run db:seed:demo -- --reset` sebelum dipakai di produksi.
SEED_DEMO_PASSWORD=ganti-saya-demo

